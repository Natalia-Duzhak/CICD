@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center" style="background-color: #f4f4f4; padding: 30px; border-radius: 10px;">
    <h1 class="display-4" style="font-family: Copperplate, Fantasy; color: #2c3e50;">Welcome to DevOps World!</h1>
    <p style="font-family: Lucida Handwriting, Cursive; font-size: 18px; color: #34495e;">Embrace automation, CI/CD, cloud computing, and containerization.</p>
    
    <h3 style="font-family: Arial, sans-serif; color: #2980b9; margin-top: 20px;">Why DevOps?</h3>
    <p style="font-family: Arial, sans-serif; font-size: 16px; color: #2c3e50; max-width: 800px; margin: 0 auto;">DevOps bridges the gap between development and operations, enabling faster software delivery, improved collaboration, and efficient infrastructure management. With DevOps practices, businesses can deploy updates rapidly, monitor applications seamlessly, and scale with ease.</p>
    
    <h3 style="font-family: Arial, sans-serif; color: #27ae60; margin-top: 20px;">DevOps Key Areas:</h3>
    <ul style="list-style-type: none; padding: 0; font-family: Arial, sans-serif; font-size: 16px; color: #2c3e50; max-width: 600px; margin: 0 auto;">
        <li>🔹 <b style="color:#e74c3c;">Continuous Integration & Continuous Deployment (CI/CD)</b> - Automate and streamline software releases.</li>
        <li>🔹 <b style="color:#f39c12;">Infrastructure as Code (IaC)</b> - Manage infrastructure efficiently using code.</li>
        <li>🔹 <b style="color:#8e44ad;">Cloud & Container Orchestration</b> - Leverage Docker, Kubernetes, and cloud solutions.</li>
        <li>🔹 <b style="color:#3498db;">Monitoring & Security</b> - Ensure stability, performance, and security of applications.</li>
    </ul>
    
    <div style="margin-top: 30px;">
        <a href="#">
            <img src="~/images/1.jpeg" alt="CI_logo" width="450" style="border-radius: 10px; box-shadow: 0px 0px 15px gray; display: block; margin: 0 auto;">
        </a>
    </div>
</div>
